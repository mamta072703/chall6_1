# GEMINI_API_KEY: Required for Gemini AI API calls on the server.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PORT: HTTP port for the Express + Vite server (default 3000)
PORT="3000"

# AQ_CACHE_TTL_MS: Optional cache TTL in milliseconds for live Open-Meteo AQI responses (default 600000 = 10 min)
AQ_CACHE_TTL_MS="600000"
